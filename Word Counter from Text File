def word_counter(filename):

    with open(filename, "r") as file:
        text = file.read()

    words = text.split()
    lines = text.splitlines()
    characters = len(text)

    print("Total Words:", len(words))
    print("Total Lines:", len(lines))
    print("Total Characters:", characters)


filename = "sample.txt"

word_counter(filename)
